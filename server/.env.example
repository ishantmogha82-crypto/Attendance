# Copy this file to .env and fill in real values before running the server.

# Port the Express API listens on
PORT=5000

# Secret used to sign admin JWT session tokens. Use a long random string in production.
JWT_SECRET=replace_this_with_a_long_random_string

# Default admin account created the first time the server starts (only if no admin exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Comma-separated list of origins allowed to call the API (your Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Recognition defaults (can also be changed later from the Settings page in the UI)
DEFAULT_MATCH_THRESHOLD=0.5
